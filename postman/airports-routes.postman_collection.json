                  "pm.test('X-Data-Source is peer', function () {",
                  "    pm.expect(pm.response.headers.get('X-Data-Source')).to.eql('peer');",
                  "});",
                  "pm.test('Airport is FAO from peer replica', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.iataCode).to.eql('FAO');",
                  "    pm.expect(json.status).to.eql('OPERATIONAL');",
                  "});"
                ],
                "type": "text/javascript"
