{
  "info": {
    "_postman_id": "7f90352b-1025-4c48-a001-c85241013ar",
    "name": "Airports & Routes Service",
    "description": "Test suite for airports-routes-service in AISafe distributed system (SIDIS 2026/2027). Covers internal service contracts, peer query forwarding, loop prevention, security, and public endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Internal Contract & P2P Forwarding",
      "item": [
        {
          "name": "GET Airport LIS (Instance 1 - Local Hit)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('X-Data-Source is local', function () {",
                  "    pm.expect(pm.response.headers.get('X-Data-Source')).to.eql('local');",
                  "});",
                  "pm.test('Airport is LIS and OPERATIONAL', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.iataCode).to.eql('LIS');",
                  "    pm.expect(json.status).to.eql('OPERATIONAL');",
                  "    pm.expect(json.certifiedModels).to.include('A320neo');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{serviceToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{instance1}}/internal/airports/LIS",
              "host": ["{{instance1}}"],
              "path": ["internal", "airports", "LIS"]
            }
          }
        },
        {
          "name": "GET Airport FAO (Instance 1 Miss -> Forward to Instance 2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
