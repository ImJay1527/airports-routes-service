        {
          "name": "GET Route route-opo-lis (Instance 1 - Local Hit)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('X-Data-Source is local', function () {",
                  "    pm.expect(pm.response.headers.get('X-Data-Source')).to.eql('local');",
                  "});",
                  "pm.test('Route matches contract shape', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.routeId).to.eql('route-opo-lis');",
                  "    pm.expect(json.status).to.eql('ACTIVE');",
                  "    pm.expect(json.distanceKm).to.eql(277.0);",
                  "    pm.expect(json.origin.iataCode).to.eql('OPO');",
                  "    pm.expect(json.destination.iataCode).to.eql('LIS');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{serviceToken}}",
                "type": "text"
