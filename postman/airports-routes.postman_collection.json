    {
      "name": "2. Public Domain APIs",
      "item": [
        {
          "name": "GET All Airports (/api/airports)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns list of airports', function () {",
                  "    var json = pm.response.json();",
                  "    var list = json._embedded ? json._embedded.airportViewDTOList : json;",
                  "    pm.expect(Array.isArray(list)).to.be.true;",
                  "    pm.expect(list.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
